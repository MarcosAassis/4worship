# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Frontend (Vercel) — leave empty in local `npm run dev` (API is served by Vite).
# In Vercel, set this to the Render URL, e.g. https://4worship-api.onrender.com
VITE_API_URL=""

# Backend (Render)
NODE_ENV="development"
PORT=3001
API_PORT=3001
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"
ALLOW_VERCEL_PREVIEWS="false"

# Resend — never expose to the frontend. Used only by the server.
RESEND_API_KEY="re_123456789_abcdef"
RESEND_FROM_EMAIL="4worship <onboarding@resend.dev>"

# Spotify Web API (Client Credentials) — server only
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# YouTube Data API v3 (optional) — server only
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""
