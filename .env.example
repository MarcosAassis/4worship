# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL / Supabase / Neon / Render)
DATABASE_URL="postgresql://user:password@localhost:5432/louvescale_db?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Resend Email Service (Transactional scale invitations & notifications)
RESEND_API_KEY="re_123456789_abcdef"
RESEND_FROM_EMAIL="escalas@4worship.com"

# Application URLs & CORS
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
PORT=3000
API_PORT=3001

# Spotify Web API (Client Credentials) — never expose the secret to the frontend
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# YouTube Data API v3 (optional). Without it, results include a YouTube search URL.
# Create a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""

